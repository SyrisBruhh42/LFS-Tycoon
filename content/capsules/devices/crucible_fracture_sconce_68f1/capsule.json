{
  "schema": 1,
  "meta": {
    "name": "Crucible Fracture Sconce",
    "description": "An enchanted device sold by an enchanter. It is socketed into a tool to catch and redirect wasted energy into the surrounding blocks. It degrades over time as it channels the explosive energies.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": [
    "carry",
    "socket_in_tool",
    "sell"
  ],
  "tags": [
    "device",
    "solves_overkill_waste",
    "path_npc_enchanter",
    "cleave",
    "crucible"
  ],
  "stats": {
    "base_value": 450.0,
    "cleave_spillover": 0.45,
    "durability_max": 250.0
  },
  "vars": {
    "durability_left": 250.0,
    "is_active": 0.0
  },
  "modifiers": [],
  "reactions": [
    {
      "on": "on_equip",
      "do": [
        {
          "act": "var_set",
          "var": "self.is_active",
          "value": "1.0"
        }
      ]
    },
    {
      "on": "on_unequip",
      "do": [
        {
          "act": "var_set",
          "var": "self.is_active",
          "value": "0.0"
        }
      ]
    },
    {
      "on": "on_block_break",
      "if": "self.is_active == 1.0 and tool.overkill_damage > 0.0 and ctx.is_secondary_damage == 0",
      "do": [
        {
          "act": "deal_damage",
          "target": "neighbors_4",
          "amount": "tool.overkill_damage * self.stats.cleave_spillover"
        },
        {
          "act": "var_add",
          "var": "self.durability_left",
          "by": "-1.0"
        },
        {
          "act": "destroy_self",
          "if": "self.durability_left <= 0.0"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/crucible_keeper_e935",
      "price": {
        "blocks/copper": 250
      }
    }
  ],
  "offline": "none"
}
