{
  "schema": 1,
  "meta": {
    "name": "Ochre Rivet Catalyst",
    "description": "A socketable or placeable gadget that vibrates with intense resonance when near hazards. It multiplies incoming damage against hazards, trading precision for pure clearing speed. The heavy vibrations degrade the catalyst over time.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": ["carry", "socket_in_tool", "place_on_tile", "sell", "catalyst"],
