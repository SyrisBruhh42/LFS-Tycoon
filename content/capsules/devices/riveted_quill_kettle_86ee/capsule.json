{
  "schema": 1,
  "meta": {
    "name": "Riveted Quill Kettle",
    "description": "A whistling brass kettle planted on the ground. Its shrill steam whistle calls chasing objectives (like the lost cat) to pause on its tile while it boils dry. Halts tile destruction while active so you don't break the floor beneath it.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": [
    "carry",
    "place_on_tile",
    "sell"
  ],
  "tags": [
    "device",
    "gadget",
    "kettle",
    "solves_event_helpers",
    "path_placeable_device"
  ],
  "stats": {
    "base_value": 45.0
  },
  "vars": {
    "steam_left": 15.0,
    "is_active": 0.0
  },
  "modifiers": [
    {
      "stat": "min_hp_clamp",
      "phase": "add",
      "if": "tile.covered_by_self and self.is_active == 1.0",
      "value": "1.0"
    }
  ],
  "reactions": [
    {
      "on": "on_second_tick",
      "if": "tile.covered_by_self and self.is_active == 1.0",
      "do": [
        {"act": "var_add", "var": "self.steam_left", "by": "-1.0"},
        {"act": "emit_alert", "channel": "hud_chime", "tag": "steam_whistle"},
        {"act": "destroy_self", "if": "self.steam_left <= 0.0"}
      ]
    },
    {
      "on": "on_damage_dealt",
      "if": "tile.covered_by_self and self.is_active == 0.0",
      "do": [
        {"act": "var_set", "var": "self.is_active", "value": "1.0"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 35}
    }
  ],
  "offline": "exact"
}
