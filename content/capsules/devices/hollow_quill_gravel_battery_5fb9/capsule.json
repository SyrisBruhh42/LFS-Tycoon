{
  "schema": 1,
  "meta": {
    "name": "Hollow Quill Gravel Battery",
    "description": "A hollow quill packed with resonance gravel. When socketed into an auto-tool, it siphons energy from struck ore veins, causing the tool to repair itself instead of wearing down, while ringing a HUD chime to alert you. Crumbles to dust after 30 ore strikes.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": [
    "carry",
    "socket_in_tool",
    "sell"
  ],
  "tags": [
    "device",
    "power_source",
    "gravel",
    "hollow",
    "quill",
    "solves_ore_hunting",
    "path_power_source"
  ],
  "stats": {
    "base_value": 45.0
  },
  "vars": {
    "charges_left": 30.0
  },
  "modifiers": [
    {
      "stat": "durability_drain_mult",
      "phase": "add",
      "if": "tile.tier > 0 and ctx.is_direct_tap == 0",
      "value": "0.35"
    }
  ],
  "reactions": [
    {
      "on": "on_damage_dealt",
      "if": "tile.tier > 0 and ctx.is_direct_tap == 0",
      "do": [
        {
          "act": "emit_alert",
          "channel": "hud_chime",
          "tag": "vein_scanned"
        },
        {
          "act": "var_add",
          "var": "self.charges_left",
          "by": "-1.0"
        },
        {
          "act": "destroy_self",
          "if": "self.charges_left <= 0.0"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 30
      }
    }
  ],
  "offline": "coarse"
}
