{
  "schema": 1,
  "meta": {
    "name": "Apprentice Anvil Depth Charm",
    "description": "An early-tier brass trinket given to apprentice anvil-smiths. While socketed or carried, reveals depth contours on newly exposed strata. Its weak magic occasionally grants a slight luck bonus on deeper blocks, but it drains durability rapidly and eventually shatters under pressure.",
    "author": "jules:session",
    "rarity": "epic"
  },
  "affordances": [
    "carry",
    "socket_in_tool",
    "sell"
  ],
  "tags": [
    "device",
    "charm",
    "depth_aid",
    "solves_depth_awareness",
    "path_magic_charm"
  ],
  "stats": {
    "base_value": 150.0
  },
  "vars": {
    "strata_revealed": 0.0
  },
  "modifiers": [
    {
      "stat": "luck_mult",
      "phase": "add",
      "value": "0.1",
      "if": "tile.depth >= 300.0"
    }
  ],
  "reactions": [
    {
      "on": "on_layer_reveal",
      "do": [
        {"act": "set_ui_flag", "flag": "hud_depth_calipers", "enabled": true},
        {"act": "var_add", "var": "self.strata_revealed", "by": "1.0"}
      ]
    },
    {
      "on": "on_block_break",
      "do": [
        {"act": "destroy_self", "if": "self.strata_revealed >= 50.0"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 150},
      "unlock_if": "tool.tier >= 2.0"
    }
  ],
  "offline": "exact"
}
