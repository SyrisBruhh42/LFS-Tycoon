{
  "schema": 1,
  "meta": {
    "name": "Munchkin's Loophole Scaffold Binding",
    "description": "A tinker binding derived from St. Munchkin's Paradox Symposium. It treats flint shale and literal intoxication as physical scaffolding, turning drunken stumbling into an impossibly stable backfill scaffold. Willow adores this paradox.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": [
    "carry",
    "place_on_tile",
    "sell",
    "socket_in_tool"
  ],
  "tags": [
    "solves_backfill_scaffolding",
    "path_field_textile",
    "craft_tinker_part",
    "logic_absurd",
    "theme_munchkin_paradox",
    "bracket_1",
    "skill_school_manual",
    "device",
    "dampener"
  ],
  "stats": {
    "base_value": 30.0
  },
  "vars": {
    "wear": 0.0,
    "wear_max": 25.0
  },
  "modifiers": [
    {
      "stat": "yield_mult",
      "phase": "mul",
      "if": "tile.covered_by_self and tile.depth < tile.max_depth_reached",
      "value": 1.2
    }
  ],
  "reactions": [
    {
      "on": "on_backfill",
      "do": [
        {
          "act": "modify_depth",
          "target": "self_tile",
          "delta": -0.5,
          "if": "tile.covered_by_self"
        },
        {
          "act": "var_add",
          "var": "self.wear",
          "by": 1.0,
          "if": "tile.covered_by_self"
        },
        {
          "act": "destroy_self",
          "if": "tile.covered_by_self and self.wear >= self.wear_max"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/deep_bore_horologist_35a3",
      "price": {
        "blocks/flint_shale_6493": 50,
        "upgrades/iron_stormbreaker_charm_a589": 1
      },
      "unlock_if": "player.max_depth >= 15"
    }
  ],
  "offline": "exact"
}
