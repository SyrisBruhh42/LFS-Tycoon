{
  "schema": 1,
  "meta": {
    "name": "Vitriol Stall Battery",
    "description": "A socketable battery laced with vitriol that provides an alternative power source. When an auto-tool strikes an impenetrable block, it trades its own charge to pause the tool's durability and battery drain, emitting a chime. The volatile mixture dramatically increases tool speed, but reduces precision, making the tool wildly inaccurate. Crumbles to dust when depleted.",
    "author": "jules:session",
    "rarity": "rare"
  },
  "affordances": [
    "carry",
    "socket_in_tool",
    "sell"
  ],
  "tags": [
    "device",
    "battery",
    "power_source",
    "vitriol",
    "solves_zero_damage_stall",
    "path_power_source"
  ],
  "stats": {
    "base_value": 75.0,
    "is_rechargeable": 0.0
  },
  "vars": {
    "charge_left": 120.0,
    "is_active": 0.0
  },
  "modifiers": [
    {
      "stat": "base_dps",
      "phase": "add",
      "value": 15.0,
      "if": "self.is_active == 1.0"
    },
    {
      "stat": "drunk_drift_px",
      "phase": "add",
      "value": 30.0,
      "if": "self.is_active == 1.0"
    }
  ],
  "reactions": [
    {
      "on": "on_equip",
      "do": [
        {
          "act": "var_set",
          "var": "self.is_active",
          "value": 1.0
        }
      ]
    },
    {
      "on": "on_unequip",
      "do": [
        {
          "act": "var_set",
          "var": "self.is_active",
          "value": 0.0
        }
      ]
    },
    {
      "on": "on_zero_damage_stall",
      "do": [
        {
          "act": "stall_tool",
          "pause_battery": true,
          "pause_durability": true,
          "if": "tile.is_strict_locked == 1.0"
        },
        {
          "act": "emit_alert",
          "channel": "hud_chime",
          "tag": "stall",
          "if": "tile.is_strict_locked == 1.0"
        }
      ]
    },
    {
      "on": "on_deplete",
      "do": [
        {
          "act": "destroy_self"
        }
      ]
    }
  ],
  "offline": "exact",
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 50
      },
      "unlock_if": "tool.tier >= 1.0"
    }
  ]
}