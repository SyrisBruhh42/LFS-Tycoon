{
  "schema": 1,
  "meta": {
    "name": "Tin Vitriol Charm",
    "description": "A magical trinket crafted from tin and vitriol. When a tool breaks a block with overkill damage, the vitriol converts the excess force into a splash that hits the shallowest 4 neighboring blocks. It burns out quickly, shattering into dust after a few uses.",
    "author": "core:ground_zero",
    "rarity": "rare"
  },
  "affordances": ["carry", "socket_in_tool", "sell"],
  "tags": ["device", "charm", "magic_charm", "solves_overkill_waste", "path_magic_charm"],
  "stats": {
    "base_value": 75.0
  },
  "vars": {
    "charges": 25.0
  },
  "modifiers": [],
  "reactions": [
    {
      "on": "on_block_break",
      "if": "tool.overkill_damage > 0",
      "do": [
        {"act": "deal_damage", "target": "shallowest_neighbor_4", "amount": "tool.overkill_damage * 0.75"},
        {"act": "var_add", "var": "self.charges", "by": "-1.0"}
      ]
    },
    {
      "on": "on_block_break",
      "if": "self.charges <= 0",
      "do": [
        {"act": "destroy_self"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 35}
    }
  ],
  "offline": "exact"
}
