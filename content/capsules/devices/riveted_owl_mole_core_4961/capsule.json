{
  "schema": 1,
  "meta": {
    "name": "Riveted Owl-Mole Core",
    "description": "A heavy clockwork core that sockets into an auto-tool. It acts as a flawless power source that completely pauses battery drain, but only when mining exactly at every 10th depth layer. It chimes softly upon breaking these milestone blocks, keeping you perfectly aware of your depth across the sheet without glancing at the HUD.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": ["carry", "socket_in_tool", "place_on_tile", "sell"],
  "tags": [
    "device",
    "power_source",
    "battery",
    "clockwork",
    "owl",
    "mole",
    "rivet",
    "acoustic",
    "solves_depth_awareness",
    "path_power_source"
  ],
  "stats": {
    "base_value": 900.0
  },
  "vars": {},
  "modifiers": [
    {
      "stat": "battery_drain_mult",
      "phase": "mul",
      "if": "tile.depth > 0 and (tile.depth - floor(tile.depth/10)*10) == 0",
      "value": "0.0"
    }
  ],
  "reactions": [
    {
      "on": "on_block_break",
      "if": "ctx.is_direct_tap == 0 and tile.depth > 0 and (tile.depth - floor(tile.depth/10)*10) == 0",
      "do": [
        {"act": "emit_alert", "channel": "hud_chime", "tag": "depth_milestone"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 900},
      "unlock_if": "player.max_depth >= 40"
    }
  ],
  "offline": "exact"
}
