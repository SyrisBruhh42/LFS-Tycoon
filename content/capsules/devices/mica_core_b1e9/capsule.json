{
  "schema": 1,
  "meta": {
    "name": "Mica Core",
    "description": "A socketed device specialized for deep strata (depth >= 500). When striking impassable strict-locked blocks, it redirects power, pausing tool durability and battery loss.",
    "author": "core:ground_zero",
    "rarity": "uncommon"
  },
  "affordances": ["carry", "socket_in_tool", "sell"],
  "tags": ["device", "solves_zero_damage_stall", "path_power_source"],
  "stats": {
    "base_value": 85.0
  },
  "vars": {},
  "modifiers": [
    {
      "stat": "durability_drain_mult",
      "phase": "mul",
      "if": "tile.is_strict_locked == 1.0 and tile.depth >= 500",
      "value": "0.1"
    },
    {
      "stat": "battery_drain_mult",
      "phase": "mul",
      "if": "tile.is_strict_locked == 1.0 and tile.depth >= 500",
      "value": "0.1"
    }
  ],
  "reactions": [
    {
      "on": "on_zero_damage_stall",
      "if": "tile.depth >= 500",
      "do": [
        {"act": "stall_tool", "pause_battery": true, "pause_durability": true}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 100}
    }
  ],
  "offline": "exact"
}
