{
  "schema": 1,
  "meta": {
    "name": "Apprentice Wick Router",
    "description": "An early-tier magical trinket glowing with a dim wick. When carried or socketed, it routes a small portion of mined ore directly into the paired chest, easing the burden of hauling. Being an apprentice piece, it slowly wears out.",
    "author": "jules:session",
    "rarity": "rare"
  },
  "affordances": [
    "carry",
    "socket_in_tool",
    "sell"
  ],
  "tags": [
    "device",
    "solves_haul_capacity",
    "path_magic_charm",
    "wick"
  ],
  "stats": {
    "base_value": 450.0
  },
  "vars": {
    "is_active": 0.0,
    "durability": 500.0
  },
  "modifiers": [
    {
      "stat": "chest_route_pct",
      "phase": "add",
      "if": "self.is_active == 1.0 and self.durability > 0.0",
      "value": 0.35
    }
  ],
  "reactions": [
    {
      "on": "on_equip",
      "do": [
        {"act": "var_set", "var": "self.is_active", "value": "1.0"}
      ]
    },
    {
      "on": "on_unequip",
      "do": [
        {"act": "var_set", "var": "self.is_active", "value": "0.0"}
      ]
    },
    {
      "on": "on_block_break",
      "do": [
        {"act": "var_add", "var": "self.durability", "by": "-1.0", "if": "self.is_active == 1.0 and self.durability > 0.0"},
        {"act": "destroy_self", "if": "self.is_active == 1.0 and self.durability == 0.0"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/crucible_keeper_e935",
      "price": {
        "blocks/copper": 1000
      },
      "unlock_if": "tool.tier >= 4.0"
    }
  ],
  "offline": "none"
}
