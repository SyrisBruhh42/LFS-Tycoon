{
  "schema": 1,
  "meta": {
    "name": "Deep-Gasket Sigil",
    "description": "An enchanter-forged gasket that channels latent pressure. When socketed into an auto-tool operating deep within the strata, it dramatically reduces battery drain. It shatters once its internal charge is fully spent.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": ["carry", "socket_in_tool", "sell"],
  "tags": ["device", "enchantment", "solves_auto_tool_runtime", "path_npc_enchanter", "gasket"],
  "stats": {
    "base_value": 75.0,
    "is_rechargeable": 0
  },
  "vars": {
    "is_active": 0.0,
    "charge_left": 3600.0
  },
  "modifiers": [
    {
      "stat": "battery_drain_mult",
      "phase": "mul",
      "value": 0.2,
      "if": "self.is_active == 1.0 and tile.depth >= 500.0"
    }
  ],
  "reactions": [
    {
      "on": "on_equip",
      "do": [
        {"act": "var_set", "var": "self.is_active", "value": 1.0}
      ]
    },
    {
      "on": "on_unequip",
      "do": [
        {"act": "var_set", "var": "self.is_active", "value": 0.0}
      ]
    },
    {
      "on": "on_deplete",
      "do": [
        {"act": "destroy_self"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 80}
    }
  ]
}
