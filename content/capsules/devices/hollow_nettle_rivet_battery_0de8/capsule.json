{
  "schema": 1,
  "meta": {
    "name": "Hollow Nettle-Rivet Battery",
    "description": "Socketed into an auto-tool. This hollow riveted core drinks in wasted overkill energy (from shattering weak blocks) to pause battery drain. However, the nettle wiring burns out permanently after absorbing 1000 overkill damage.",
    "author": "jules:0de8",
    "rarity": "rare"
  },
  "affordances": ["carry", "socket_in_tool", "sell"],
  "tags": ["device", "battery", "hollow", "nettle", "rivet", "solves_overkill_waste", "path_power_source"],
  "stats": {
    "base_value": 85.0
  },
  "vars": {
    "active_boost_seconds": 0.0,
    "overkill_absorbed": 0.0
  },
  "modifiers": [
    {
      "stat": "battery_drain_mult",
      "phase": "mul",
      "if": "self.active_boost_seconds > 0.0",
      "value": "0.0"
    }
  ],
  "reactions": [
    {
      "on": "on_overkill",
      "if": "ctx.is_direct_tap == 0",
      "do": [
        {"act": "var_add", "var": "self.active_boost_seconds", "by": "tool.overkill_damage * 0.1"},
        {"act": "var_add", "var": "self.overkill_absorbed", "by": "tool.overkill_damage"},
        {"act": "destroy_self", "if": "self.overkill_absorbed >= 1000.0"}
      ]
    },
    {
      "on": "on_second_tick",
      "if": "self.active_boost_seconds > 0.0",
      "do": [
        {"act": "var_add", "var": "self.active_boost_seconds", "by": "-1.0"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 85}
    }
  ],
  "offline": "exact"
}
