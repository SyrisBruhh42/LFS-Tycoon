{
  "schema": 1,
  "meta": {
    "name": "Umber Demolition Charm",
    "description": "A socketable magical trinket that glows with umber energy. It multiplies incoming damage dealt to hazard blocks at extreme depths (below Z=500). The intense magic degrades the charm with every hazard detonation it witnesses.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": ["carry", "socket_in_tool", "sell"],
  "tags": ["device", "solves_hazard_clearing", "path_magic_charm"],
  "stats": {
    "base_value": 75.0
  },
  "vars": {
    "wear": 0.0
  },
  "modifiers": [
    {
      "stat": "incoming_damage",
      "phase": "mul",
      "if": "tile.is_hazard == 1.0 and tile.depth >= 500.0",
      "value": "2.5"
    }
  ],
  "reactions": [
    {
      "on": "on_hazard_detonate",
      "if": "tile.depth >= 500.0",
      "do": [
        {"act": "var_add", "var": "self.wear", "by": "1.0"},
        {"act": "destroy_self", "if": "self.wear >= 15.0"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 50}
    }
  ],
  "offline": "exact"
}
