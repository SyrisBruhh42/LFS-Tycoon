{
  "schema": 1,
  "meta": {
    "name": "Ember Badger Ledger",
    "description": "A clever gadget placed on a tile that completely absorbs secondary impact damage to protect the underlying block. It vanishes in a flash of embers after 15 uses.",
    "author": "jules:session",
    "rarity": "epic"
  },
  "affordances": [
    "carry",
    "place_on_tile",
    "sell"
  ],
  "tags": [
    "device",
    "gadget",
    "solves_unwanted_splash",
    "path_placeable_device",
    "disposable",
    "ember",
    "ledger",
    "badger"
  ],
  "stats": {
    "base_value": 450.0,
    "dampen_pct": 1.0,
    "wear_max": 15.0
  },
  "vars": {
    "wear": 0.0
  },
  "modifiers": [
    {
      "stat": "incoming_damage",
      "phase": "mul",
      "if": "tile.covered_by_self and ctx.is_direct_tap == 0",
      "value": "1.0 - self.stats.dampen_pct"
    }
  ],
  "reactions": [
    {
      "on": "on_damage_absorbed",
      "if": "tile.covered_by_self",
      "do": [
        {"act": "var_add", "var": "self.wear", "by": "1.0"},
        {"act": "destroy_self", "if": "self.wear >= self.stats.wear_max"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 150},
      "unlock_if": "player.max_depth >= 15"
    }
  ],
  "offline": "exact"
}
