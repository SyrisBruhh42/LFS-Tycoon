{
  "schema": 1,
  "meta": {
    "name": "Cinder-Rivet Sigil",
    "description": "A scorching, rivet-studded sigil forged by an enchanter. Once socketed into a tool, it massively boosts mining power when encountering hazards. It is highly volatile, wearing down its durability rapidly as it cleaves through dangerous materials.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": [
    "socket_in_tool",
    "carry",
    "sell"
  ],
  "tags": [
    "device",
    "sigil",
    "enchantment",
    "disposable",
    "cinder",
    "rivet",
    "solves_hazard_clearing",
    "path_npc_enchanter"
  ],
  "stats": {
    "base_value": 75.0,
    "durability_max": 200.0
  },
  "vars": {
    "durability_left": 200.0
  },
  "modifiers": [
    {
      "stat": "base_dps",
      "phase": "mul",
      "value": "1.0 + (tile.is_hazard * 1.5)"
    },
    {
      "stat": "incoming_damage",
      "phase": "mul",
      "value": "1.0 - (tile.is_hazard * 0.5)"
    }
  ],
  "reactions": [
    {
      "on": "on_damage_dealt",
      "if": "tile.is_hazard == 1",
      "do": [
        {
          "act": "var_add",
          "var": "self.durability_left",
          "by": "-1.0"
        },
        {
          "act": "destroy_self",
          "if": "self.durability_left <= 0.0"
        }
      ]
    },
    {
      "on": "on_deplete",
      "do": [
        {
          "act": "destroy_self"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/rivet_smith_6a68",
      "price": {
        "blocks/copper": 50
      }
    }
  ],
  "offline": "exact"
}
