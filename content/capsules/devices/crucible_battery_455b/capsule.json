{
  "schema": 1,
  "meta": {
    "name": "Crucible Ledger Matrix",
    "description": "A heavy, disposable ledger matrix placed on a tile to project stable power flow. Halves the battery drain of active auto-tools on the same tile. Wears down over 24 hours of operation and then shatters.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": [
    "carry",
    "place_on_tile",
    "sell"
  ],
  "tags": [
    "device",
    "solves_auto_tool_runtime",
    "path_placeable_device",
    "crucible",
    "ledger"
  ],
  "stats": {
    "base_value": 450.0
  },
  "vars": {
    "charge_left": 86400.0
  },
  "modifiers": [
    {
      "stat": "battery_drain_mult",
      "phase": "mul",
      "value": "0.5",
      "if": "tile.covered_by_self"
    }
  ],
  "reactions": [
    {
      "on": "on_second_tick",
      "if": "self.charge_left > 0.0 and tile.covered_by_self",
      "do": [
        {"act": "var_add", "var": "self.charge_left", "by": "-1.0"},
        {"act": "destroy_self", "if": "self.charge_left <= 0.0"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/crucible_keeper_e935",
      "price": {
        "blocks/copper": 300
      },
      "unlock_if": "player.max_depth >= 15"
    }
  ],
  "offline": "exact"
}
