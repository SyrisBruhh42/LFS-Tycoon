{
  "schema": 1,
  "meta": {
    "name": "Iron-Bone Mortar",
    "description": "Place this hefty mortar on a tile. Striking it reverses your tool's wear, repairing it instead! However, the foul bone-dust makes your hands slip and the tile very stubborn to break.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": [
    "carry",
    "place_on_tile",
    "sell"
  ],
  "tags": [
    "device",
    "gadget",
    "mortar",
    "iron",
    "bone",
    "solves_repair_upkeep",
    "path_placeable_device"
  ],
  "stats": {
    "base_value": 250.0
  },
  "vars": {
    "repair_hits": 0.0
  },
  "modifiers": [
    {
      "stat": "durability_drain_mult",
      "phase": "mul",
      "if": "tile.covered_by_self",
      "value": "-1.5"
    },
    {
      "stat": "incoming_damage",
      "phase": "clamp",
      "if": "tile.covered_by_self",
      "value": "2.0"
    },
    {
      "stat": "drunk_drift_px",
      "phase": "add",
      "if": "tile.covered_by_self",
      "value": "20.0"
    }
  ],
  "reactions": [
    {
      "on": "on_damage_dealt",
      "if": "tile.covered_by_self",
      "do": [
        {"act": "var_add", "var": "self.repair_hits", "by": "1.0"}
      ]
    },
    {
      "on": "on_damage_dealt",
      "if": "tile.covered_by_self and self.repair_hits >= 10.0",
      "do": [
        {"act": "emit_alert", "channel": "hud_chime", "tag": "repair_ping"},
        {"act": "var_set", "var": "self.repair_hits", "value": "0.0"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/stone": 350, "blocks/copper": 150},
      "unlock_if": "player.max_depth >= 15"
    }
  ],
  "offline": "exact"
}
