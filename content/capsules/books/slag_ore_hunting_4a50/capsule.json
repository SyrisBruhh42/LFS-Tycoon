{
  "schema": 1,
  "meta": {
    "name": "Slag Diviner",
    "description": "A crude manual written in hot slag. Reading it grants a clumsy 10% bonus to finding veins, but the pages fall apart after clearing 60 blocks.",
    "author": "core:ground_zero",
    "rarity": "common"
  },
  "affordances": [
    "carry",
    "read_book",
    "sell"
  ],
  "tags": [
    "book",
    "skill_book",
    "solves_ore_hunting",
    "path_skill_book",
    "slag"
  ],
  "stats": {
    "base_value": 75.0,
    "is_rechargeable": 0
  },
  "vars": {
    "is_learned": 0.0,
    "charge_left": 60.0
  },
  "modifiers": [
    {
      "stat": "luck_mult",
      "phase": "mul",
      "value": 1.10,
      "if": "self.is_learned >= 1.0 and self.charge_left > 0.0"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "if": "self.is_learned == 0.0",
      "do": [
        {
          "act": "var_set",
          "var": "self.is_learned",
          "value": 1.0
        }
      ]
    },
    {
      "on": "on_deplete",
      "if": "self.is_learned >= 1.0",
      "do": [
        {
          "act": "destroy_self"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 300
      }
    }
  ],
  "offline": "none"
}
