{
  "schema": 1,
  "meta": {
    "name": "Mica Prospector's Almanac",
    "description": "A fragile, flaky journal filled with early prospecting theories. Reading it grants a temporary 15% bonus to luck, making finding hidden veins slightly easier. The delicate knowledge fades after unearthing 50 blocks.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": ["carry", "read_book", "sell"],
  "tags": ["book", "skill_book", "solves_ore_hunting", "path_skill_book"],
  "stats": {
    "base_value": 75.0
  },
  "vars": {
    "is_learned": 0.0,
    "charge_left": 50.0
  },
  "modifiers": [
    {
      "stat": "luck_mult",
      "phase": "mul",
      "value": "1.15",
      "if": "self.is_learned >= 1.0 and self.charge_left > 0.0"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "if": "self.is_learned == 0.0",
      "do": [
        {"act": "var_set", "var": "self.is_learned", "value": "1.0"}
      ]
    },
    {
      "on": "on_block_break",
      "if": "self.is_learned >= 1.0 and self.charge_left > 0.0",
      "do": [
        {"act": "var_add", "var": "self.charge_left", "by": "-1.0"}
      ]
    },
    {
      "on": "on_block_break",
      "if": "self.is_learned >= 1.0 and self.charge_left <= 0.0",
      "do": [
        {"act": "destroy_self"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 50}
    }
  ],
  "offline": "none"
}
