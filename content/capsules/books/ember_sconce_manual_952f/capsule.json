{
  "schema": 1,
  "meta": {
    "name": "Ember Sconce Manual",
    "description": "A faint ember sconce illuminates this dusty manual. Reading it teaches you how to better handle tools when striking deep stone, partially reducing the wrong tool penalty when working below depth 500.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": [
    "carry",
    "read_book",
    "sell"
  ],
  "tags": [
    "book",
    "skill_book",
    "solves_wrong_tool_penalty",
    "path_skill_book"
  ],
  "stats": {
    "base_value": 50.0,
    "penalty_relief": 0.5
  },
  "vars": {
    "is_learned": 0.0
  },
  "modifiers": [
    {
      "stat": "wrong_tool_penalty",
      "phase": "mul",
      "value": "self.stats.penalty_relief",
      "if": "self.is_learned >= 1.0 and tile.depth >= 500.0"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "if": "self.is_learned == 0.0",
      "do": [
        {
          "act": "var_set",
          "var": "self.is_learned",
          "value": "1.0"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 50
      }
    }
  ],
  "offline": "none"
}
