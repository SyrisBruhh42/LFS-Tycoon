{
  "schema": 1,
  "meta": {
    "name": "Tome of Crude Shattering (Vol. I)",
    "description": "A dog-eared quarry manual. Reading it teaches you to channel 8% of overkill impact into a random orthogonal neighbor—clumsy and unguided, but never wasted.",
    "author": "core:ground_zero",
    "rarity": "uncommon"
  },
  "affordances": ["carry", "read_book", "sell"],
  "tags": ["book", "skill_book", "cleave", "crude"],
  "stats": {
    "base_value": 80.0,
    "splash_pct": 0.08
  },
  "vars": {
    "is_learned": 0.0
  },
  "modifiers": [],
  "reactions": [
    {
      "on": "on_consume",
      "if": "self.is_learned == 0.0",
      "do": [
        {"act": "var_set", "var": "self.is_learned", "value": "1.0"},
        {"act": "var_add", "var": "shared.global_cleave_bonus_pct", "by": "self.stats.splash_pct"}
      ]
    },
    {
      "on": "on_overkill",
      "if": "self.is_learned >= 1.0 and tool.overkill_damage > 0.0 and ctx.is_secondary_damage == 0",
      "do": [
        {
          "act": "deal_damage",
          "target": "random_neighbor_4",
          "amount": "tool.overkill_damage * self.stats.splash_pct"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 55}
    }
  ],
  "offline": "none"
}
