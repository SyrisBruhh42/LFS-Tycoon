{
  "schema": 1,
  "meta": {
    "name": "Tallow Clockwork Calipers Manual",
    "description": "A thriftily bound folk-science manual from The Perpetual Clockwork Deep-Bore Syndicate. Its tallow-stained pages outline a whimsical logic: if you rub hollow stone dust on a pair of calipers, they naturally 'want' to find the quarry bottom. Reading it grants a temporary depth awareness overlay (hud_depth_calipers) on deep strata, but the knowledge slips away after 50 layer reveals.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": [
    "carry",
    "read_book",
    "sell"
  ],
  "tags": [
    "book",
    "skill_book",
    "solves_depth_awareness",
    "path_skill_book",
    "craft_clockwork_automaton",
    "logic_whimsical",
    "theme_clockwork_syndicate",
    "bracket_2",
    "skill_school_manual"
  ],
  "stats": {
    "base_value": 50.0
  },
  "vars": {
    "is_learned": 0.0,
    "uses_left": 50.0
  },
  "modifiers": [
    {
      "stat": "break_time_mult",
      "phase": "mul",
      "value": "0.98",
      "if": "self.is_learned >= 1.0 and tile.depth >= 198.0"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "if": "self.is_learned == 0.0",
      "do": [
        {
          "act": "var_set",
          "var": "self.is_learned",
          "value": "1.0"
        }
      ]
    },
    {
      "on": "on_layer_reveal",
      "if": "self.is_learned >= 1.0",
      "do": [
        {
          "act": "set_ui_flag",
          "flag": "hud_depth_calipers",
          "enabled": true
        },
        {
          "act": "var_add",
          "var": "self.uses_left",
          "by": "-1.0"
        },
        {
          "act": "destroy_self",
          "if": "self.uses_left <= 0.0"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/deep_bore_horologist_35a3",
      "price": {
        "upgrades/flint_hollow_choir_sponge_d53f": 1,
        "blocks/hollow_stone_b96c": 12
      },
      "unlock_if": "player.max_depth >= 198.0 and player.max_depth <= 330.0"
    }
  ],
  "offline": "none"
}
