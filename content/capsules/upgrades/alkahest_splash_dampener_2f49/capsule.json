{
  "schema": 1,
  "meta": {
    "name": "Alkahest Splash Dampener",
    "description": "An iron-bound alchemical trinket carrying the bioluminescent spore cartography of The Living Atlas & Mycelial Sanctuary of the Enclave. It safely diffuses the explosive shock of deep-strata excavation into a soft hum. Socketed on an alkahest pickaxe or carried, it reduces splash damage to 15% when breaking tiles. Wears out after absorbing the shock of 200 block breaks.",
    "author": "autonomous:content_developer",
    "rarity": "uncommon"
  },
  "affordances": ["carry", "socket_in_tool", "sell"],
  "tags": [
    "upgrade",
    "solves_unwanted_splash",
    "path_magic_charm",
    "craft_achievement_relic",
    "logic_canonical",
    "theme_enclave_living_atlas",
    "bracket_1",
    "skill_school_manual"
  ],
  "stats": {
    "base_value": 75.0,
    "base_dps": 20.0,
    "is_rechargeable": 0.0
  },
  "vars": {
    "durability_left": 200.0,
    "is_active": 0.0
  },
  "modifiers": [
    {
      "stat": "incoming_damage",
      "phase": "mul",
      "if": "self.is_active == 1.0 and ctx.is_secondary_damage == 1.0",
      "value": 0.15
    }
  ],
  "reactions": [
    {
      "on": "on_equip",
      "do": [
        {"act": "var_set", "var": "self.is_active", "value": 1.0}
      ]
    },
    {
      "on": "on_unequip",
      "do": [
        {"act": "var_set", "var": "self.is_active", "value": 0.0}
      ]
    },
    {
      "on": "on_block_break",
      "do": [
        {
          "act": "var_add",
          "var": "self.durability_left",
          "by": -1.0,
          "if": "self.is_active == 1.0"
        }
      ]
    },
    {
      "on": "on_deplete",
      "do": [
        {"act": "destroy_self"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/mycelial_artisan_f58c",
      "price": {
        "tools/brass_alkahest_pick_ad60": 1,
        "blocks/quill_ore_4083": 15
      },
      "unlock_if": "player.max_depth >= 150"
    }
  ],
  "offline": "none"
}
