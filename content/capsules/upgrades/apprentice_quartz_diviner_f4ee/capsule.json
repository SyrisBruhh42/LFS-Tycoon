          "if": "self.installed == 1.0"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 900
      },
      "unlock_if": "tool.tier >= 4.0"
    }
  ],
