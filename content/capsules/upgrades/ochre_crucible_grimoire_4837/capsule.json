  "schema": 1,
  "meta": {
    "name": "Ochre Crucible Grimoire",
    "description": "An arcane spell tome from the ancient smith-lords of The Grand Crucible of the Tectonic Leviathan. By channeling deep-earth harmonics into your mind, this grimoire allows your physical strikes to gently pause at the brink of destruction, halting accidental taps from finishing off a block while directly touching the display. Furthermore, it channels overkill force into a chained geometric resonance.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": [
    "carry",
    "consume",
    "sell"
  ],
  "tags": [
    "upgrade",
    "qol",
    "solves_tap_misfires",
