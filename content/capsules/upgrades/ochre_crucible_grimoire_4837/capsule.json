  "stats": {
    "base_value": 60.0
  },
  "vars": {
    "is_learned": 0.0
  },
  "modifiers": [
    {
      "stat": "min_hp_clamp",
      "phase": "base",
      "if": "self.is_learned >= 1.0 and ctx.is_direct_tap == 1.0",
      "value": 1.0
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "if": "self.is_learned == 0.0",
      "do": [
        {
          "act": "var_set",
          "var": "self.is_learned",
          "value": 1.0
        }
      ]
    },
    {
      "on": "on_overkill",
      "if": "self.is_learned >= 1.0 and ctx.is_secondary_damage == 0",
      "do": [
        {
          "act": "deal_damage",
          "target": "neighbors_4",
          "amount": "tool.overkill_damage * 0.25"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/ochre_toad_5e64",
      "unlock_if": "shared.quarry_resonance_charge >= 0.0",
      "price": {
        "upgrades/ochre_forge_milestone_relic_9ed9": 1,
        "blocks/ochre_stratum_d812": 15
      }
    }
  ],
