{
  "schema": 1,
  "meta": {
    "name": "Lantern Vendor Bundle",
    "description": "A bundled lantern ledger granting significant depth discounts for merchants. Thrifty and reliable for early miners, wearing out after 200 sales.",
    "author": "core:ground_zero",
    "rarity": "uncommon"
  },
  "affordances": [
    "carry",
    "consume",
    "sell"
  ],
  "tags": [
    "upgrade",
    "qol",
    "solves_vendor_access",
    "path_bundle_package",
    "lantern"
  ],
  "stats": {
    "base_value": 120.0,
    "is_rechargeable": 0.0
  },
  "vars": {
    "installed": 0.0,
    "durability_left": 200.0
  },
  "modifiers": [
    {
      "stat": "vendor_depth_discount",
      "phase": "add",
      "value": 35.0,
      "if": "self.installed > 0.0 and self.durability_left > 0.0"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "do": [
        {"act": "var_set", "var": "self.installed", "value": 1.0}
      ]
    },
    {
      "on": "on_deplete",
      "do": [
        {"act": "destroy_self"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 100}
    }
  ],
  "offline": "none"
}
