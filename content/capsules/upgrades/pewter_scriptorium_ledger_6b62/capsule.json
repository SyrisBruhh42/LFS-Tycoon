{
  "schema": 1,
  "meta": {
    "name": "Pewter Scriptorium Ledger",
    "description": "Transcribed by the blind monastic archivists of Quill Hollow, this ledger holds the acoustic secrets of the Lithic Choir to refine raw ores. Once read, it grants a bonus to market value for your sales until its pewter seals are broken. Striking a block for zero damage will also consume hollow quill ore to build quarry resonance.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": ["carry", "read_book", "sell"],
  "tags": [
    "upgrade",
    "solves_market_saturation",
    "path_profession_perk",
    "craft_smeltery_alloy",
    "logic_canonical",
    "theme_lithic_choir",
    "bracket_2",
    "skill_school_manual"
  ],
  "stats": {
    "base_value": 150.0
  },
  "vars": {
    "installed": 0.0,
    "charges_left": 100.0
  },
  "modifiers": [
    {
      "stat": "market_value_mult",
      "phase": "add",
      "value": 0.25,
      "if": "self.installed == 1.0 and self.charges_left > 0.0"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "do": [
        {"act": "var_set", "var": "self.installed", "value": "1.0"}
      ]
    },
    {
      "on": "on_zero_damage_stall",
      "do": [
        {"act": "consume_item", "item": "blocks/quill_hollow_fa6d", "qty": 1, "if": "self.installed == 1.0"},
        {"act": "var_add", "var": "shared.quarry_resonance_charge", "by": "15.0", "if": "self.installed == 1.0"}
      ]
    },
    {
      "on": "on_market_sell",
      "do": [
        {"act": "var_add", "var": "self.charges_left", "by": "-1.0", "if": "self.installed == 1.0 and self.charges_left > 0.0"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/pewter_quill_newt_3730",
      "unlock_if": "player.max_depth >= 200.0",
      "price": {
        "devices/flint_shale_scrubber_b898": 1,
        "blocks/quill_hollow_fa6d": 15
      }
    }
  ],
  "offline": "none"
}
