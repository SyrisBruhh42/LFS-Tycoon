          "if": "self.installed >= 1.0 and tile.fluid_level > 0.0"
        }
      ]
    },
    {
      "on": "on_block_break",
      "do": [
        {
          "act": "consume_item",
          "item": "blocks/alkahest_shale_981c",
          "qty": 1,
          "if": "self.installed >= 1.0"
        }
      ]
    }
  ],
  "offline": "none",
  "offered_by": [
    {
      "vendor": "npcs/alkahest_vendor_a46c",
      "price": {
        "devices/resonant_sigil_2e45": 1,
        "blocks/alkahest_shale_981c": 50,
        "blocks/copper": 50
      },
      "unlock_if": "player.max_depth >= 250.0"
    }
  ]
