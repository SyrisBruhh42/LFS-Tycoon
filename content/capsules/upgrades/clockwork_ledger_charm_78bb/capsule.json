      "do": [
        {"act": "deal_damage", "if": "self.charges_left > 0.0", "target": "neighbors_4", "amount": "10.0"},
        {"act": "var_add", "if": "self.charges_left > 0.0", "var": "self.charges_left", "by": "-1.0"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/deep_bore_horologist_35a3",
      "price": {
        "consumables/alkahest_decoction_dae2": 1,
        "blocks/cinder_gravel_61a3": 40
      },
      "unlock_if": "player.max_depth <= 330"
    }
  ],
  "offline": "none"
