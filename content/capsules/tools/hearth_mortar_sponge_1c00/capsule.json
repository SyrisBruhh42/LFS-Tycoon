{
  "schema": 1,
  "meta": {
    "name": "Hearth Mortar Automaton Sponge",
    "description": "A wind-up hearth clay laborer that diligently siphons liquids from the block it sits on. Decays faster when left running on dry ground.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": ["carry", "equip_tool", "place_on_tile", "sell"],
  "tags": ["tool", "bucket", "automaton", "disposable", "solves_fluid_flooding", "path_hired_laborer", "hearth"],
  "stats": {
    "tool_type": "BUCKET",
    "tool_tier": 1,
    "base_dps": 20.0,
    "charge_max_sec": 3600.0,
    "durability_max": 300.0,
    "is_rechargeable": 0,
    "base_value": 75.0
  },
  "vars": {
    "charge_left": 3600.0,
    "durability_left": 300.0
  },
  "modifiers": [],
  "reactions": [
    {
      "on": "on_second_tick",
      "if": "self.charge_left > 0.0 and tile.fluid_level > 0.0",
      "do": [
        {"act": "modify_fluid", "target": "self_tile", "fluid_type": "NONE", "delta_level": "-1.0"},
        {"act": "var_add", "var": "self.charge_left", "by": "-1.0"},
        {"act": "destroy_self", "if": "self.charge_left <= 0.0"}
      ]
    },
    {
      "on": "on_second_tick",
      "if": "self.charge_left > 0.0 and tile.fluid_level == 0.0",
      "do": [
        {"act": "var_add", "var": "self.charge_left", "by": "-5.0"},
        {"act": "destroy_self", "if": "self.charge_left <= 0.0"}
      ]
    },
    {
      "on": "on_deplete",
      "do": [
        {"act": "destroy_self"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 35},
      "unlock_if": "shared.global_cleave_bonus_pct >= 0.0"
    }
  ],
  "offline": "coarse"
}
