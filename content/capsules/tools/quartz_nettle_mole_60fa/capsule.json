{
  "schema": 1,
  "meta": {
    "name": "Quartz-Nettle Mole",
    "description": "A prickly, clockwork automaton that ferociously burrows downward to hunt veins. It cannot break ores; upon finding one, it halts and violently rings the house bell. However, its quartz gears are highly allergic to moisture and danger, shattering instantly upon touching fluids or hazards. Runs for 30 minutes.",
    "author": "jules:session",
    "rarity": "epic"
  },
  "affordances": [
    "carry",
    "equip_tool",
    "place_on_tile",
    "sell"
  ],
  "tags": [
    "tool",
    "pickaxe",
    "automine",
    "clockwork",
    "disposable",
    "solves_ore_hunting",
    "path_hired_laborer",
    "quartz",
    "nettle",
    "mole"
  ],
  "stats": {
    "tool_type": "PICKAXE",
    "tool_tier": 1,
    "base_dps": 25.0,
    "charge_max_sec": 1800.0,
    "durability_max": 200.0,
    "is_rechargeable": 0,
    "base_value": 120.0
  },
  "vars": {
    "charge_left": 1800.0,
    "durability_left": 200.0
  },
  "modifiers": [
    {
      "stat": "base_dps",
      "phase": "mul",
      "if": "tile.tier > 0",
      "value": "0.0"
    }
  ],
  "reactions": [
    {
      "on": "on_second_tick",
      "if": "self.charge_left > 0.0",
      "do": [
        {"act": "var_add", "var": "self.charge_left", "by": "-1.0"},
        {"act": "destroy_self", "if": "self.charge_left <= 0.0"}
      ]
    },
    {
      "on": "on_damage_calc",
      "if": "tile.tier > 0",
      "do": [
        {"act": "emit_alert", "channel": "house_bell", "tag": "mole_found_ore"},
        {"act": "stall_tool", "pause_battery": false, "pause_durability": true}
      ]
    },
    {
      "on": "on_damage_calc",
      "if": "tile.fluid_level > 0 or tile.is_hazard == 1",
      "do": [
        {"act": "destroy_self"}
      ]
    },
    {
      "on": "on_deplete",
      "do": [
        {"act": "destroy_self"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 120
      }
    }
  ],
  "offline": "coarse"
}
