{
  "schema": 1,
  "meta": {
    "name": "Mica Crucible Laborer Clockwork Pick",
    "description": "An autonomous clockwork crucible tool forged from pewter gravel by the blind monastic archivists of Quill Hollow (part of The Infinite Scriptorium of the Lithic Choir). Operating decoupled from the player, it chips away to ease the early-game drudgery while its zero-damage stalls and bell harmonics can shatter contours and refine pewter gravel into advanced alloys.",
    "author": "jules:session",
    "rarity": "rare"
  },
  "affordances": ["carry", "equip_tool", "place_on_tile", "sell"],
  "tags": [
    "tool",
    "pickaxe",
