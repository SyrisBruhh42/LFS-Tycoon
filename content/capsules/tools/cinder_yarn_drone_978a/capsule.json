{
  "schema": 1,
  "meta": {
    "name": "Cinder Yarn Drone",
    "description": "A fragile, disposable drone spun from cinder yarn. When placed on a block, it completely absorbs secondary splash damage to protect the block, while slowly auto-mining it for up to 1 hour. It turns to dust if it depletes its wind-up or absorbs too much damage.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": [
    "carry",
    "place_on_tile",
    "sell"
  ],
  "tags": [
    "tool",
    "drone",
    "automine",
    "disposable",
    "solves_unwanted_splash",
    "path_hired_laborer",
    "cinder",
    "yarn",
    "gravel"
  ],
  "stats": {
    "base_value": 45.0,
    "dampen_pct": 1.0,
    "charge_max_sec": 3600.0,
    "durability_max": 20.0,
    "base_dps": 8.0
  },
  "vars": {
    "charge_left": 3600.0,
    "durability_left": 20.0
  },
  "modifiers": [
    {
      "stat": "incoming_damage",
      "phase": "mul",
      "if": "tile.covered_by_self and ctx.is_direct_tap == 0",
      "value": "1.0 - self.stats.dampen_pct"
    }
  ],
  "reactions": [
    {
      "on": "on_second_tick",
      "if": "self.charge_left > 0.0 and tile.covered_by_self",
      "do": [
        {
          "act": "deal_damage",
          "target": "self_tile",
          "amount": "4.0"
        },
        {
          "act": "var_add",
          "var": "self.charge_left",
          "by": "-1.0"
        },
        {
          "act": "destroy_self",
          "if": "self.charge_left <= 0.0"
        }
      ]
    },
    {
      "on": "on_damage_absorbed",
      "if": "tile.covered_by_self",
      "do": [
        {
          "act": "var_add",
          "var": "self.durability_left",
          "by": "-1.0"
        },
        {
          "act": "destroy_self",
          "if": "self.durability_left <= 0.0"
        }
      ]
    },
    {
      "on": "on_deplete",
      "do": [
        {
          "act": "destroy_self"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 30
      },
      "unlock_if": "player.max_depth >= 15"
    }
  ],
  "offline": "exact"
}
