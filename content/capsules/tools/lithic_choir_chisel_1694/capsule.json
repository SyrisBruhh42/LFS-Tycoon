    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "if": "self.is_learned == 0.0",
      "do": [
        {
          "act": "var_set",
          "var": "self.is_learned",
          "value": "1.0"
        },
        {
          "act": "var_add",
          "var": "shared.global_cleave_bonus_pct",
          "by": "self.stats.splash_pct"
        }
      ]
    },
    {
      "on": "on_zero_damage_stall",
      "if": "tile.tier >= 1.0",
      "do": [
        {
          "act": "deal_damage",
          "target": "shallowest_neighbor_4",
          "amount": "tool.dps * 0.25"
        }
      ]
    },
    {
      "on": "on_overkill",
      "if": "tool.overkill_damage > 50.0",
      "do": [
        {
          "act": "spawn_item",
          "item": "blocks/pewter_gravel_d53e",
          "qty": 1
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/deep_bore_horologist_35a3",
      "price": {
        "devices/cinder_quill_lure_bell_9bce": 1,
        "tools/salt_tempered_chisel_c52e": 1,
        "blocks/pewter_gravel_d53e": 45
      },
      "unlock_if": "player.max_depth >= 198"
    }
