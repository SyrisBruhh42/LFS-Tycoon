{
  "schema": 1,
  "meta": {
    "name": "Alkahest Galena Automaton",
    "description": "An autonomous subterranean hydro-alchemist tool built to treat the 14x31 quarry as a terraced chemical alembic. Fueled by Living Atlas Galena, it floods strata with brine and vitriol to soften rock and route refined ores. A situational trade-off: it is clumsy and applies a penalty if used strictly on soft dirt.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": ["carry", "equip_tool", "place_on_tile", "sell"],
  "tags": [
    "tool",
    "pickaxe",
    "automine",
    "clockwork",
    "disposable",
    "solves_haul_capacity",
    "path_hired_laborer",
