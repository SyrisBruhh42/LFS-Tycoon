{
  "schema": 1,
  "meta": {
    "name": "Wren's Wick Hearth-Spade",
    "description": "An enchanted shovel infused with a burning wren's wick. As you break blocks deep in the earth (depth >= 30), it magically raises the floor from below to backfill the space. Lasts exactly 5 minutes of winding heat before crumbling to ash.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": ["carry", "equip_tool", "sell"],
  "tags": [
    "tool",
    "shovel",
    "wren",
    "wick",
    "hearth",
    "enchantment",
    "disposable",
    "solves_backfill_scaffolding",
    "path_vendor_disposable"
  ],
  "stats": {
    "tool_type": "SHOVEL",
    "tool_tier": 2,
    "base_dps": 25.0,
    "durability_max": 800.0,
    "is_rechargeable": 0,
    "base_value": 45.0
  },
  "vars": {
    "charge_left": 300.0,
    "durability_left": 800.0
  },
  "modifiers": [],
  "reactions": [
    {
      "on": "on_block_break",
      "if": "tile.depth >= 30 and ctx.is_secondary_damage == 0",
      "do": [
        {
          "act": "modify_depth",
          "target": "self_tile",
          "delta": "-1"
        }
      ]
    },
    {
      "on": "on_second_tick",
      "if": "self.charge_left > 0.0",
      "do": [
        {"act": "var_add", "var": "self.charge_left", "by": "-1.0"},
        {"act": "destroy_self", "if": "self.charge_left <= 0.0"}
      ]
    },
    {
      "on": "on_deplete",
      "do": [
        {"act": "destroy_self"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 250},
      "unlock_if": "player.max_depth >= 30"
    }
  ],
  "offline": "coarse"
}
