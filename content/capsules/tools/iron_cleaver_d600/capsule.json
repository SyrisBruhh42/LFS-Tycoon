{
  "schema": 1,
  "meta": {
    "name": "Iron Cleaver",
    "description": "Forged from dense iron. Extremely effective in deep strata, turning overkill force into collateral damage for neighboring rocks.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": ["carry", "equip_tool", "sell"],
  "tags": ["tool", "pickaxe", "tinker_forged", "iron", "cleave", "solves_overkill_waste", "path_forge_material"],
  "stats": {
    "tool_type": "PICKAXE",
    "tool_tier": 2,
    "base_dps": 40.0,
    "cleave_spillover": 0.40,
    "durability_max": 900.0,
    "is_rechargeable": 1,
    "base_value": 300.0
  },
  "vars": {
    "durability_left": 900.0
  },
  "offered_by": [
    {
      "vendor": "npcs/anvil_smith_73cd",
      "price": {
        "blocks/copper": 300
      },
      "unlock_if": "player.max_depth >= 500"
    }
  ],
  "modifiers": [
    {
      "stat": "cleave_pct",
      "phase": "add",
      "value": "self.stats.cleave_spillover",
      "if": "tile.depth >= 500"
    }
  ],
  "reactions": [
    {
      "on": "on_block_break",
      "do": [
        {
          "act": "deal_damage",
          "target": "shallowest_neighbor_4",
          "amount": "tool.overkill_damage * self.stats.cleave_spillover",
          "if": "tool.overkill_damage > 0.0 and ctx.is_direct_tap == 1 and tile.depth >= 500"
        }
      ]
    }
  ],
  "offline": "none"
}
