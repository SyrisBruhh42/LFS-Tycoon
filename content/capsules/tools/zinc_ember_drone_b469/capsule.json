{
  "schema": 1,
  "meta": {
    "name": "Zinc Ember Drone",
    "description": "A crude, wind-up zinc automaton powered by a smoldering hearth ember. It dutifully clear-cuts hazards and stubborn obsidian before its delicate zinc housing melts from the heat. A disposable, short-lived laborer.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": [
    "carry",
    "equip_tool",
    "place_on_tile",
    "sell"
  ],
  "tags": [
    "tool",
    "demolition",
    "automine",
    "clockwork",
    "disposable",
    "hearth",
    "zinc",
    "ember",
    "solves_hazard_clearing",
    "path_hired_laborer",
    "path_vendor_disposable"
  ],
  "stats": {
    "tool_type": "DEMOLITION",
    "tool_tier": 1,
    "base_dps": 20.0,
    "charge_max_sec": 7200.0,
    "durability_max": 500.0,
    "is_rechargeable": 0,
    "base_value": 40.0
  },
  "vars": {
    "charge_left": 7200.0,
    "durability_left": 500.0
  },
  "modifiers": [
    {
      "stat": "base_dps",
      "phase": "mul",
      "value": "1.5 + (tile.is_hazard * 1.5)"
    }
  ],
  "reactions": [
    {
      "on": "on_second_tick",
      "if": "self.charge_left > 0.0",
      "do": [
        {
          "act": "var_add",
          "var": "self.charge_left",
          "by": "-1.0"
        },
        {
          "act": "destroy_self",
          "if": "self.charge_left <= 0.0"
        }
      ]
    },
    {
      "on": "on_deplete",
      "do": [
        {
          "act": "destroy_self"
        }
      ]
    },
    {
      "on": "on_hazard_expose",
      "do": [
        {
          "act": "var_add",
          "var": "self.durability_left",
          "by": "-10.0"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 30
      }
    }
  ],
  "offline": "coarse"
}
