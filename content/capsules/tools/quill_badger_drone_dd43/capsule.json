{
  "schema": 1,
  "meta": {
    "name": "Clockwork Quill-Badger",
    "description": "An automated digging contraption shaped like a sturdy badger with quills made of ledger-spikes. It mines vigorously for one hour, providing extra copper drops to fund your vendor trips. Breaks upon running out of tension.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": ["carry", "equip_tool", "place_on_tile", "sell"],
  "tags": ["tool", "shovel", "automine", "clockwork", "disposable", "badger", "quill", "solves_vendor_access", "path_hired_laborer"],
  "stats": {
    "tool_type": "SHOVEL",
    "tool_tier": 5,
    "base_dps": 15.0,
    "charge_max_sec": 3600.0,
    "durability_max": 2000.0,
    "is_rechargeable": 0,
    "base_value": 2000.0
  },
  "vars": {
    "charge_left": 3600.0,
    "durability_left": 2000.0
  },
  "modifiers": [],
  "reactions": [
    {
      "on": "on_second_tick",
      "if": "self.charge_left > 0.0",
      "do": [
        {"act": "var_add", "var": "self.charge_left", "by": "-1.0"},
        {"act": "destroy_self", "if": "self.charge_left <= 0.0"}
      ]
    },
    {
      "on": "on_deplete",
      "do": [
        {"act": "destroy_self"}
      ]
    },
    {
      "on": "on_block_break",
      "do": [
        {"act": "spawn_item", "item": "blocks/copper", "qty": "5", "route": "backpack"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 1500},
      "unlock_if": "player.max_depth >= 45"
    }
  ],
  "offline": "coarse"
}
