{
  "schema": 1,
  "meta": {
    "name": "Crucible Bucket",
    "description": "A specialized tool woven from sturdy fibers and forged in extreme heat. When placed on a flooded tile, it continually absorbs the fluid on its own timer for 4 hours (14,400s), enabling excavation of stubborn fluid pockets. The intense process gives it high durability.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": ["carry", "equip_tool", "place_on_tile", "sell"],
  "tags": ["tool", "bucket", "automine", "disposable", "solves_fluid_flooding", "path_hired_laborer", "crucible"],
  "stats": {
    "tool_type": "BUCKET",
    "tool_tier": 2,
    "base_dps": 20.0,
    "charge_max_sec": 14400.0,
    "durability_max": 2000.0,
    "is_rechargeable": 0,
    "base_value": 150.0
  },
  "vars": {
    "charge_left": 14400.0,
    "durability_left": 2000.0
  },
  "modifiers": [],
  "reactions": [
    {
      "on": "on_second_tick",
      "if": "self.charge_left > 0.0",
      "do": [
        {"act": "var_add", "var": "self.charge_left", "by": "-1.0"},
        {"act": "modify_fluid", "target": "tile", "fluid_type": "NONE", "delta_level": "-1.0", "if": "tile.fluid_level > 0.0"},
        {"act": "destroy_self", "if": "self.charge_left <= 0.0"}
      ]
    },
    {
      "on": "on_deplete",
      "do": [
        {"act": "destroy_self"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/crucible_keeper_e935",
      "price": {"blocks/copper": 150},
      "unlock_if": "player.max_depth >= 30.0"
    }
  ],
  "offline": "coarse"
}
