{
  "schema": 1,
  "meta": {
    "name": "Ember Tea",
    "description": "A piping hot tea brewed from ember loam. When consumed by a rested player, grants massive luck and yield bonuses for a short duration, but slows mining slightly.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": [
    "carry",
    "consume",
    "place_in_house",
    "sell"
  ],
  "tags": [
    "consumable",
    "drink",
    "tea",
    "solves_house_comfort",
    "path_consumable_buff"
  ],
  "stats": {
    "base_value": 35.0,
    "duration_sec": 120.0,
    "speed_penalty": 1.1,
    "luck_boost": 2.5,
    "yield_boost": 2.0
  },
  "vars": {
    "active_sec_left": -1.0
  },
  "modifiers": [
    {
      "stat": "break_time_mult",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "self.stats.speed_penalty"
    },
    {
      "stat": "luck_mult",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "self.stats.luck_boost"
    },
    {
      "stat": "yield_mult",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "self.stats.yield_boost"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "do": [
        {
          "act": "var_set",
          "var": "self.active_sec_left",
          "value": "self.stats.duration_sec"
        }
      ]
    },
    {
      "on": "on_second_tick",
      "if": "self.active_sec_left > 0.0",
      "do": [
        {
          "act": "var_add",
          "var": "self.active_sec_left",
          "by": "-1.0"
        },
        {
          "act": "destroy_self",
          "if": "self.active_sec_left <= 0.0"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/dirt": 50
      }
    }
  ],
  "offline": "none"
}
