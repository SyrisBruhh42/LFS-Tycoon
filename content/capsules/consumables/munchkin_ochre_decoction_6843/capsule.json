{
  "schema": 1,
  "meta": {
    "name": "Munchkin's Ochre Mortar Decoction",
    "description": "A bizarrely literal interpretation of The Brass Ledger Frontier's trade laws. St. Munchkin's Paradox Symposium found that if a subterranean bureaucrat uses Ochre Stratum and a Lithic Quill Tome as a makeshift mortar, the Bismuth Broker will honor an outrageous vendor discount.",
    "author": "jules:session",
    "rarity": "rare"
  },
  "affordances": ["carry", "consume", "sell"],
  "tags": [
    "consumable",
    "solves_vendor_access",
    "path_profession_perk",
    "craft_alchemy_potion",
    "logic_absurd",
    "theme_munchkin_paradox",
    "bracket_1",
    "skill_school_assayers",
    "craft_achievement_relic"
  ],
  "stats": {
    "base_value": 120.0,
    "duration_sec": 300.0,
    "base_dps": 25.0
  },
  "vars": {
    "active_sec_left": 0.0
  },
  "modifiers": [
    {
      "stat": "vendor_depth_discount",
      "phase": "add",
      "value": 20.0,
      "if": "self.active_sec_left > 0.0 and tile.depth >= 50.0"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "do": [
        {"act": "var_set", "var": "self.active_sec_left", "value": "self.stats.duration_sec"}
      ]
    },
    {
      "on": "on_second_tick",
      "do": [
        {"act": "var_add", "var": "self.active_sec_left", "by": "-1.0", "if": "self.active_sec_left > 0.0"},
        {"act": "destroy_self", "if": "self.active_sec_left <= 0.0"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/bismuth_broker_af6a",
      "price": {
        "devices/lithic_quill_tome_6b11": 1,
        "blocks/ochre_stratum_d812": 10
      },
      "unlock_if": "player.max_depth >= 50.0"
    }
  ]
}
