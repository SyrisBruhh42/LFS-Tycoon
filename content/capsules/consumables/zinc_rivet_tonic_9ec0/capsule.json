{
  "schema": 1,
  "meta": {
    "name": "Zinc Rivet Tonic",
    "description": "A dense, metallic brew. Doubles mining speed and triple yields for a short burst to help afford expensive vendors, but renders you dangerously vulnerable to hazards.",
    "author": "core:jules",
    "rarity": "rare"
  },
  "affordances": [
    "carry",
    "consume",
    "sell"
  ],
  "tags": [
    "consumable",
    "drink",
    "potion",
    "buff_speed",
    "buff_yield",
    "debuff_safety",
    "solves_vendor_access",
    "path_consumable_buff"
  ],
  "stats": {
    "base_value": 150.0,
    "duration_sec": 120.0,
    "speed_mult": 2.0,
    "yield_mult": 3.0,
    "damage_mult": 5.0
  },
  "vars": {
    "active_sec_left": -1.0
  },
  "modifiers": [
    {
      "stat": "base_dps",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "self.stats.speed_mult"
    },
    {
      "stat": "yield_mult",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "self.stats.yield_mult"
    },
    {
      "stat": "incoming_damage",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "self.stats.damage_mult"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "if": "self.active_sec_left <= 0.0",
      "do": [
        {
          "act": "var_set",
          "var": "self.active_sec_left",
          "value": "self.stats.duration_sec"
        }
      ]
    },
    {
      "on": "on_second_tick",
      "if": "self.active_sec_left > 0.0",
      "do": [
        {
          "act": "var_add",
          "var": "self.active_sec_left",
          "by": "-1.0"
        }
      ]
    },
    {
      "on": "on_second_tick",
      "if": "self.active_sec_left == 0.0",
      "do": [
        {
          "act": "destroy_self"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 500
      }
    }
  ],
  "offline": "none"
}