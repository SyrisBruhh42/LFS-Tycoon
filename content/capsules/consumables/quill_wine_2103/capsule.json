{
  "schema": 1,
  "meta": {
    "name": "Quill Wine",
    "description": "A sharp-tasting common brew that focuses your taps. It clamps accidental taps so you don't break protected tiles, and synergizes with clean hands (less than 15 grime) to reduce tool wear. The intense focus drains your tool faster otherwise.",
    "author": "core:jules",
    "rarity": "common"
  },
  "affordances": ["carry", "consume", "sell"],
  "tags": ["consumable", "drink", "wine", "solves_tap_misfires", "path_consumable_buff", "quill"],
  "stats": {
    "base_value": 30.0,
    "duration_sec": 180.0,
    "clamp_val": 1.0,
    "wear_penalty": 2.0,
    "clean_wear_bonus": 0.5
  },
  "vars": {
    "active_sec_left": -1.0
  },
  "modifiers": [
    {
      "stat": "min_hp_clamp",
      "phase": "base",
      "if": "self.active_sec_left > 0.0 and ctx.is_direct_tap == 1.0",
      "value": "self.stats.clamp_val"
    },
    {
      "stat": "durability_drain_mult",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0 and player.grime >= 15.0",
      "value": "self.stats.wear_penalty"
    },
    {
      "stat": "durability_drain_mult",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0 and player.grime < 15.0",
      "value": "self.stats.clean_wear_bonus"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "do": [
        {"act": "var_set", "var": "self.active_sec_left", "value": "self.stats.duration_sec"}
      ]
    },
    {
      "on": "on_second_tick",
      "do": [
        {"act": "var_add", "var": "self.active_sec_left", "by": -1.0, "if": "self.active_sec_left > 0.0"},
        {"act": "destroy_self", "if": "self.active_sec_left == 0.0"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 30}
    }
  ]
}
