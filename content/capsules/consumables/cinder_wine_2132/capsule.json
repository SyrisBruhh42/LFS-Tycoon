{
  "schema": 1,
  "meta": {
    "name": "Cinder Wine",
    "description": "A heavy, smoky wine brewed with cinder extract. Its pungent aroma increases the chance of drawing out a cavern cat for 3 minutes, but the dizzying vintage halves your mining speed.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": [
    "carry",
    "consume",
    "sell"
  ],
  "tags": [
    "consumable",
    "drink",
    "wine",
    "cinder",
    "solves_event_helpers",
    "path_consumable_buff"
  ],
  "stats": {
    "base_value": 150.0,
    "duration_sec": 180.0
  },
  "vars": {
    "active_sec_left": 0.0
  },
  "modifiers": [
    {
      "stat": "cat_lure_bonus",
      "phase": "add",
      "if": "self.active_sec_left > 0.0",
      "value": "0.04"
    },
    {
      "stat": "break_time_mult",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "2.0"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "do": [
        {
          "act": "var_set",
          "var": "self.active_sec_left",
          "value": "self.stats.duration_sec"
        }
      ]
    },
    {
      "on": "on_second_tick",
      "if": "self.active_sec_left > 0.0",
      "do": [
        {
          "act": "var_add",
          "var": "self.active_sec_left",
          "by": "-1.0"
        },
        {
          "act": "destroy_self",
          "if": "self.active_sec_left <= 0.0"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 300
      },
      "unlock_if": "player.max_depth >= 15"
    }
  ],
  "offline": "none"
}
