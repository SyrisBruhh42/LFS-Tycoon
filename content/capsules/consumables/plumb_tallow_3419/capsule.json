{
  "schema": 1,
  "meta": {
    "name": "Plumb Tallow",
    "description": "A dense, rich tallow mixed with plumb. Reveals contours when layers are revealed for 5 minutes, but its heaviness slows down your manual tap speed.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": [
    "carry",
    "consume",
    "sell"
  ],
  "tags": [
    "consumable",
    "potion",
    "solves_ore_hunting",
    "path_consumable_buff",
    "plumb"
  ],
  "stats": {
    "base_value": 50.0,
    "duration_sec": 300.0,
    "speed_mult": 0.5
  },
  "vars": {
    "active_sec_left": -1.0
  },
  "modifiers": [
    {
      "stat": "base_dps",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "self.stats.speed_mult"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "do": [
        {
          "act": "var_set",
          "var": "self.active_sec_left",
          "value": "self.stats.duration_sec"
        }
      ]
    },
    {
      "on": "on_second_tick",
      "do": [
        {
          "act": "var_add",
          "var": "self.active_sec_left",
          "by": "-1.0",
          "if": "self.active_sec_left > 0.0"
        },
        {
          "act": "destroy_self",
          "if": "self.active_sec_left == 0.0"
        }
      ]
    },
    {
      "on": "on_layer_reveal",
      "if": "self.active_sec_left > 0.0",
      "do": [
        {
          "act": "set_ui_flag",
          "flag": "hud_chalk_lines",
          "enabled": true
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 35}
    }
  ]
}
