{
  "schema": 1,
  "meta": {
    "name": "Crucible Basalt Wine",
    "description": "A hearty wine brewed from basalt and refined in a crucible. For 3 minutes, significantly boosts ore yield by 50% and doubles luck, but drastically decreases mining speed.",
    "author": "jules:session",
    "rarity": "rare"
  },
  "affordances": [
    "carry",
    "consume",
    "sell"
  ],
  "tags": [
    "consumable",
    "drink",
    "wine",
    "solves_ore_hunting",
    "path_consumable_buff"
  ],
  "stats": {
    "base_value": 200.0,
    "duration_sec": 180.0
  },
  "vars": {
    "active_sec_left": -1.0
  },
  "modifiers": [
    {
      "stat": "yield_mult",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "1.5"
    },
    {
      "stat": "luck_mult",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "2.0"
    },
    {
      "stat": "break_time_mult",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "2.0"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "if": "self.active_sec_left <= 0.0",
      "do": [
        {
          "act": "var_set",
          "var": "self.active_sec_left",
          "value": "self.stats.duration_sec"
        }
      ]
    },
    {
      "on": "on_second_tick",
      "if": "self.active_sec_left > 0.0",
      "do": [
        {
          "act": "var_add",
          "var": "self.active_sec_left",
          "by": "-1.0"
        }
      ]
    },
    {
      "on": "on_second_tick",
      "if": "self.active_sec_left == 0.0",
      "do": [
        {
          "act": "destroy_self"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 250
      },
      "unlock_if": "player.max_depth >= 15"
    }
  ],
  "offline": "none"
}
