{
  "schema": 1,
  "meta": {
    "name": "Vitriol Plumb Tonic",
    "description": "A dense, metallic brew that anchors your intent. For 5 minutes, direct manual taps cannot reduce a tile below 1 HP, preventing accidental breaks from fat fingers. However, the heavy plumb slows your base mining speed slightly.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": ["carry", "consume", "sell"],
  "tags": [
    "consumable",
    "drink",
    "tonic",
    "solves_tap_misfires",
    "path_consumable_buff",
    "vitriol",
    "plumb",
    "limiter"
  ],
  "stats": {
    "base_value": 40.0,
    "duration_sec": 300.0,
    "speed_penalty": 0.8
  },
  "vars": {
    "active_sec_left": -1.0
  },
  "modifiers": [
    {
      "stat": "min_hp_clamp",
      "phase": "base",
      "if": "self.active_sec_left > 0.0 and ctx.is_direct_tap == 1",
      "value": "1.0"
    },
    {
      "stat": "base_dps",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "self.stats.speed_penalty"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "do": [
        {"act": "var_set", "var": "self.active_sec_left", "value": "self.stats.duration_sec"}
      ]
    },
    {
      "on": "on_second_tick",
      "if": "self.active_sec_left > 0.0",
      "do": [
        {"act": "var_add", "var": "self.active_sec_left", "by": "-1.0"}
      ]
    },
    {
      "on": "on_second_tick",
      "if": "self.active_sec_left == 0.0",
      "do": [
        {"act": "destroy_self"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/copper": 1000},
      "unlock_if": "tool.tier >= 4.0"
    }
  ],
  "offline": "none"
}
