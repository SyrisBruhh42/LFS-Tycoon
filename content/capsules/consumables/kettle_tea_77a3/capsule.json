{
  "schema": 1,
  "meta": {
    "name": "Kettle Tea",
    "description": "A potent brewed tea that sharpens your focus, lessening the wrong tool penalty so you can mine off-class blocks efficiently for 3 minutes, but causes rapid tool durability wear as you push tools past their design.",
    "author": "core:ground_zero",
    "rarity": "uncommon"
  },
  "affordances": ["carry", "consume", "sell"],
  "tags": ["consumable", "drink", "kettle", "solves_wrong_tool_penalty", "path_consumable_buff"],
  "stats": {
    "base_value": 90.0,
    "duration_sec": 180.0
  },
  "vars": {
    "is_consumed": 0.0,
    "active_sec_left": 0.0
  },
  "modifiers": [
    {
      "stat": "wrong_tool_penalty",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "0.5"
    },
    {
      "stat": "durability_drain_mult",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "1.5"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "do": [
        {
          "act": "var_set",
          "var": "self.is_consumed",
          "value": "1.0"
        },
        {
          "act": "var_set",
          "var": "self.active_sec_left",
          "value": "self.stats.duration_sec"
        }
      ]
    },
    {
      "on": "on_second_tick",
      "do": [
        {
          "act": "var_add",
          "var": "self.active_sec_left",
          "by": "-1.0",
          "if": "self.active_sec_left > 0.0"
        }
      ]
    },
    {
      "on": "on_second_tick",
      "do": [
        {
          "act": "destroy_self",
          "if": "self.is_consumed == 1.0 and self.active_sec_left <= 0.0"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 1000
      },
      "unlock_if": "player.max_depth >= 50"
    }
  ],
  "offline": "none"
}
