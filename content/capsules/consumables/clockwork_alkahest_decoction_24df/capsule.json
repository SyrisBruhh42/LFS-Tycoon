{
  "schema": 1,
  "meta": {
    "name": "Clockwork Alkahest Decoction",
    "description": "A potent alchemical decoction brewed with ancient brass and resilient mica, reflecting The Living Atlas & Mycelial Sanctuary of the Enclave. It aggressively cleanses the user, reducing grime buildup drastically for a short time, while also magically transmuting clockwork brass when stalled.",
    "author": "jules:steward",
    "rarity": "rare"
  },
  "affordances": [
    "carry",
    "consume",
    "sell"
  ],
  "tags": [
    "consumable",
    "drink",
    "path_consumable_buff",
    "solves_grime_cleanliness",
    "craft_alchemy_potion",
    "bracket_4",
    "skill_school_assayers",
    "theme_enclave_living_atlas",
    "logic_canonical",
    "steward_keystone"
  ],
  "stats": {
    "base_value": 350.0
  },
  "vars": {
    "active_sec_left": 0.0
  },
  "modifiers": [
    {
      "stat": "grime_gain_mult",
      "phase": "mul",
      "value": 0.1,
      "if": "self.active_sec_left > 0.0"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "do": [
        {
          "act": "var_set",
          "var": "self.active_sec_left",
          "value": 180.0
        }
      ]
    },
    {
      "on": "on_second_tick",
      "do": [
        {
          "act": "var_add",
          "var": "self.active_sec_left",
          "by": -1.0,
          "if": "self.active_sec_left > 0.0"
        },
        {
          "act": "destroy_self",
          "if": "self.active_sec_left == 0.0"
        }
      ]
    },
    {
      "on": "on_zero_damage_stall",
      "do": [
        {
          "act": "consume_item",
          "item": "blocks/clockwork_brass_409a",
          "qty": 1,
          "if": "self.active_sec_left > 0.0"
        },
        {
          "act": "spawn_item",
          "item": "blocks/obsidian_mica_ward_a85f",
          "qty": 1,
          "if": "self.active_sec_left > 0.0"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/alkahest_vendor_300e",
      "price": {
        "upgrades/stormbreaker_bellows_pick_1080": 1,
        "blocks/clockwork_brass_409a": 5,
        "blocks/obsidian_mica_ward_a85f": 5
      },
      "unlock_if": "player.max_depth >= 880.0"
    }
  ]
}
