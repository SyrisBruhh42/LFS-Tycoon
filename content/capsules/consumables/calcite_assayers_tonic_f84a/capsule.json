{
  "schema": 1,
  "meta": {
    "name": "Calcite Assayer's Tonic",
    "description": "A gritty, sparkling tonic infused with calcite. It temporarily hones your bartering wits, granting a +50% bonus to market value for 2 minutes. However, the calcite haze halves your manual mining speed.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": ["carry", "consume", "sell"],
  "tags": ["consumable", "drink", "tonic", "solves_market_saturation", "path_consumable_buff"],
  "stats": {
    "base_value": 20.0,
    "duration_sec": 120.0,
    "value_bonus": 0.5,
    "dps_penalty": 0.5
  },
  "vars": {
    "active_sec_left": -1.0
  },
  "modifiers": [
    {
      "stat": "market_value_mult",
      "phase": "add",
      "value": "self.stats.value_bonus",
      "if": "self.active_sec_left > 0.0"
    },
    {
      "stat": "base_dps",
      "phase": "mul",
      "value": "self.stats.dps_penalty",
      "if": "self.active_sec_left > 0.0 and ctx.is_direct_tap == 1"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "do": [
        {"act": "var_set", "var": "self.active_sec_left", "value": "self.stats.duration_sec"}
      ]
    },
    {
      "on": "on_second_tick",
      "if": "self.active_sec_left > 0.0",
      "do": [
        {"act": "var_add", "var": "self.active_sec_left", "by": "-1.0"},
        {"act": "destroy_self", "if": "self.active_sec_left == 0.0"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/dirt": 100}
    }
  ]
}
