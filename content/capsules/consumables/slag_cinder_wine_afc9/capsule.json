{
  "schema": 1,
  "meta": {
    "name": "Slag Cinder Wine",
    "description": "A potent, glowing vintage brewed from crushed slag and cinder. Reduces the penalty of using off-class tools, especially when consumed well rested, but sharply accelerates tool durability drain during its effects.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": [
    "carry",
    "consume",
    "sell"
  ],
  "tags": [
    "consumable",
    "wine",
    "drink",
    "cinder",
    "slag",
    "solves_wrong_tool_penalty",
    "path_consumable_buff"
  ],
  "stats": {
    "base_value": 45.0,
    "duration_sec": 300.0,
    "wrong_tool_mult": 0.5,
    "wrong_tool_mult_rested": 0.25,
    "wear_penalty": 2.0
  },
  "vars": {
    "active_sec_left": -1.0
  },
  "modifiers": [
    {
      "stat": "wrong_tool_penalty",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0 and player.is_rested == 0.0",
      "value": "self.stats.wrong_tool_mult"
    },
    {
      "stat": "wrong_tool_penalty",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0 and player.is_rested == 1.0",
      "value": "self.stats.wrong_tool_mult_rested"
    },
    {
      "stat": "durability_drain_mult",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0",
      "value": "self.stats.wear_penalty"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "do": [
        {
          "act": "var_set",
          "var": "self.active_sec_left",
          "value": "self.stats.duration_sec"
        }
      ]
    },
    {
      "on": "on_second_tick",
      "do": [
        {
          "act": "var_add",
          "var": "self.active_sec_left",
          "by": "-1.0",
          "if": "self.active_sec_left > 0.0"
        },
        {
          "act": "destroy_self",
          "if": "self.active_sec_left == 0.0"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 1000
      },
      "unlock_if": "tool.tier >= 4.0"
    }
  ]
}
