{
  "schema": 1,
  "meta": {
    "name": "Ember Tea",
    "description": "A piping hot tea sold by the Ember Vendor. When exploring the deep strata, it temporarily cleanses grime accumulation, though it makes your hands shake slightly.",
    "author": "core:ground_zero",
    "rarity": "uncommon"
  },
  "affordances": ["carry", "consume", "sell"],
  "tags": ["consumable", "drink", "tea", "solves_grime_cleanliness", "path_consumable_buff"],
  "stats": {
    "base_value": 40.0,
    "duration_sec": 180.0,
    "grime_mul": 0.2,
    "drift_px": 25.0
  },
  "vars": {
    "active_sec_left": 0.0
  },
  "modifiers": [
    {
      "stat": "grime_gain_mult",
      "phase": "mul",
      "if": "self.active_sec_left > 0.0 and tile.depth >= 500.0",
      "value": "self.stats.grime_mul"
    },
    {
      "stat": "drunk_drift_px",
      "phase": "add",
      "if": "self.active_sec_left > 0.0",
      "value": "self.stats.drift_px"
    }
  ],
  "reactions": [
    {
      "on": "on_consume",
      "do": [
        {"act": "var_set", "var": "self.active_sec_left", "value": "self.stats.duration_sec"},
        {"act": "var_set", "var": "shared.active_drunk_drift_px", "value": "self.stats.drift_px"},
        {"act": "destroy_self"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/ember_vendor_f749",
      "price": {"blocks/dirt": 40}
    }
  ]
}
