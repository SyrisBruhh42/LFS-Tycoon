{
  "schema": 1,
  "meta": {
    "name": "Quill-Nettle Mortar Covering",
    "description": "A prickly covering woven from stinging nettles and stiff quills. It acts as a mortar, aggressively grinding the tile beneath it. It drastically speeds up mining (x3 incoming damage) but recklessly splinters damage to neighboring tiles (trading safety for speed). Its mortar action destroys the standard ore yield, instead sifting out valuable copper bits to help bypass local market saturation.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": [
    "carry",
    "place_on_tile",
    "sell"
  ],
  "tags": [
    "textile",
    "tile_cover",
    "mortar",
    "quill",
    "nettle",
    "solves_market_saturation",
    "path_field_textile"
  ],
  "stats": {
    "base_value": 45.0,
    "wear_max": 30.0
  },
  "vars": {
    "wear": 0.0
  },
  "modifiers": [
    {
      "stat": "incoming_damage",
      "phase": "mul",
      "if": "tile.covered_by_self",
      "value": "3.0"
    },
    {
      "stat": "yield_mult",
      "phase": "mul",
      "if": "tile.covered_by_self",
      "value": "0.0"
    }
  ],
  "reactions": [
    {
      "on": "on_damage_dealt",
      "if": "tile.covered_by_self and ctx.is_secondary_damage == 0",
      "do": [
        {
          "act": "deal_damage",
          "target": "neighbors_4",
          "amount": "10.0"
        },
        {
          "act": "var_add",
          "var": "self.wear",
          "by": "1.0"
        },
        {
          "act": "spawn_item",
          "item": "blocks/copper",
          "qty": "1",
          "if": "roll(0.15)"
        },
        {
          "act": "destroy_self",
          "if": "self.wear >= self.stats.wear_max"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 20
      }
    }
  ],
  "offline": "exact"
