{
  "schema": 1,
  "meta": {
    "name": "Flint Backfill Mat",
    "description": "A rough mat woven from thick fibers and embedded with flint shards. When laid down, it doubles backfill efficiency (raising the floor further) by catching dirt and debris, but the tough flint fibers make mining the tile 30% slower as a trade-off. It degrades after 15 backfills.",
    "author": "core:ground_zero",
    "rarity": "common"
  },
  "affordances": [
    "carry",
    "place_on_tile",
    "sell"
  ],
  "tags": [
    "textile",
