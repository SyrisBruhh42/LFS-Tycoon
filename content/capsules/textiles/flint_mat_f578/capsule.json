    "flint",
    "solves_backfill_scaffolding",
    "path_field_textile"
  ],
  "stats": {
    "base_value": 40.0,
    "wear_max": 15.0
  },
  "vars": {
    "wear": 0.0
  },
  "modifiers": [
    {
      "stat": "break_time_mult",
      "phase": "mul",
      "if": "tile.covered_by_self",
      "value": 1.3
    }
  ],
  "reactions": [
    {
      "on": "on_backfill",
      "if": "tile.covered_by_self",
      "do": [
        {
          "act": "modify_depth",
          "target": "self_tile",
          "delta": -1.0
        },
        {
          "act": "var_add",
          "var": "self.wear",
          "by": 1.0
        },
        {
          "act": "destroy_self",
          "if": "self.wear >= self.stats.wear_max"
        }
      ]
    }
  ],
