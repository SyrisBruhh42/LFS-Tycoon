{
  "schema": 1,
  "meta": {
    "name": "Crucible Cinder Weave",
    "description": "Forged by the ancient smith-lords of the Under-Sun Manifold, this thick ember-infused covering dampens vibrations while keeping the earth beneath it warm. The Grand Crucible of the Tectonic Leviathan bound magma veins to create this resilient layer.",
    "author": "jules:session",
    "rarity": "rare"
  },
  "affordances": [
    "carry",
    "place_on_tile",
    "backfill_material",
    "sell"
  ],
  "tags": [
    "textile",
    "tile_cover",
    "dampener",
    "solves_backfill_scaffolding",
    "path_field_textile",
    "craft_clockwork_automaton",
    "logic_canonical",
    "theme_tectonic_crucible",
    "bracket_1",
    "skill_school_pewter_cinder"
  ],
  "stats": {
    "base_value": 75.0,
    "dampen_pct": 0.50,
    "wear_max": 25.0
  },
  "vars": {
    "wear": 0.0
  },
  "modifiers": [
    {
      "stat": "incoming_damage",
      "phase": "mul",
      "if": "tile.covered_by_self and ctx.is_direct_tap == 0",
      "value": "1.0 - self.stats.dampen_pct"
    },
    {
      "stat": "yield_mult",
      "phase": "add",
      "if": "tile.tier >= 1.0",
      "value": 0.50
    }
  ],
  "reactions": [
    {
      "on": "on_damage_absorbed",
      "if": "tile.covered_by_self",
      "do": [
        {
          "act": "var_add",
          "var": "self.wear",
          "by": "1.0"
        },
        {
          "act": "destroy_self",
          "if": "self.wear >= self.stats.wear_max"
        }
      ]
    },
    {
      "on": "on_backfill",
      "if": "tile.depth < tile.max_depth_reached",
      "do": [
        {
          "act": "spawn_item",
          "item": "blocks/quill_ore_4083",
          "qty": 1
        },
        {
          "act": "var_add",
          "var": "self.wear",
          "by": "2.0"
        },
        {
          "act": "destroy_self",
          "if": "self.wear >= self.stats.wear_max"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/deep_bore_horologist_35a3",
      "price": {
        "devices/quill_crucible_9ff0": 1,
        "blocks/quill_ore_4083": 30
      },
      "unlock_if": "player.max_depth >= 40"
    }
  ],
  "offline": "exact"
}
