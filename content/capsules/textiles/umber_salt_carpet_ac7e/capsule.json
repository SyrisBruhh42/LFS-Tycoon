          "by": "1.0"
        },
        {
          "act": "destroy_self",
          "if": "self.wear >= self.stats.wear_max"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 50
      },
      "unlock_if": "shared.house_bell_ringing >= 0.0"
    }
  ]
}
