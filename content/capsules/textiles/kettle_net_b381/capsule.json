  "schema": 1,
  "meta": {
    "name": "Heavy Kettle Net",
    "description": "A weighted covering woven from heavy hemp and kettle-iron beads. When placed on a tile, it attracts stray lost cats, increasing the chance of an emergent event on layer reveal. The trade-off: its bulk significantly slows down the breaking of the tile it covers. Snaps and destroys itself after capturing an event or 20 blocks broken under it.",
    "author": "jules:session",
    "rarity": "common"
  },
