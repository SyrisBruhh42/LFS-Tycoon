{
  "schema": 1,
  "meta": {
    "name": "Iron-Nettle Stoat Rug",
    "description": "A rugged stoat-fur rug woven with iron nettle. Dampens 70% of impact damage, but dampens 95% when placed over a hazard block (interacting with the hazard tag). After absorbing 15 hits, the woven spell breaks and transmutes it into Peddler Vayne, providing remote vendor access.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": ["carry", "place_on_tile", "sell"],
  "tags": ["textile", "tile_cover", "dampener", "iron", "nettle", "stoat", "solves_vendor_access", "path_field_textile"],
  "stats": {
    "base_value": 120.0,
    "dampen_pct": 0.70,
    "hazard_dampen_pct": 0.95,
    "wear_max": 15.0
  },
  "vars": {
    "wear": 0.0
  },
  "modifiers": [
    {
      "stat": "incoming_damage",
      "phase": "mul",
      "if": "tile.covered_by_self and ctx.is_direct_tap == 0 and tile.is_hazard == 0",
      "value": "1.0 - self.stats.dampen_pct"
    },
    {
      "stat": "incoming_damage",
      "phase": "mul",
      "if": "tile.covered_by_self and ctx.is_direct_tap == 0 and tile.is_hazard == 1",
      "value": "1.0 - self.stats.hazard_dampen_pct"
    }
  ],
  "reactions": [
    {
      "on": "on_damage_absorbed",
      "if": "tile.covered_by_self",
      "do": [
        {"act": "var_add", "var": "self.wear", "by": "1.0"},
        {"act": "transmute_self", "into": "npcs/peddler_vayne", "if": "self.wear >= self.stats.wear_max"}
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {"blocks/dirt": 120}
    }
  ],
  "offline": "exact"
}
