{
  "schema": 1,
  "meta": {
    "name": "Iron Wick Mesh",
    "description": "A heavy mesh of iron and fire-resistant wick. When placed and then backfilled with dirt or gravel, it magically raises the floor by a small extra amount but takes damage. It rewards thoughtful placement.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": [
    "carry",
    "place_on_tile",
    "sell"
  ],
  "tags": [
    "textile",
    "tile_cover",
    "dampener",
    "solves_backfill_scaffolding",
    "path_field_textile"
  ],
  "stats": {
    "base_value": 30.0,
    "wear_max": 25.0
  },
  "vars": {
    "wear": 0.0
  },
  "modifiers": [
    {
      "stat": "yield_mult",
      "phase": "mul",
      "if": "tile.covered_by_self and tile.depth < tile.max_depth_reached",
      "value": "1.2"
    }
  ],
  "reactions": [
    {
      "on": "on_backfill",
      "if": "tile.covered_by_self",
      "do": [
        {
          "act": "modify_depth",
          "target": "self_tile",
          "delta": "-0.5"
        },
        {
          "act": "var_add",
          "var": "self.wear",
          "by": "1.0"
        },
        {
          "act": "destroy_self",
          "if": "self.wear >= self.stats.wear_max"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 30
      }
    }
  ],
  "offline": "exact"
}
