{
  "schema": 1,
  "meta": {
    "name": "Ochre Kettle Cinder",
    "description": "A heavy, cinder-woven barrier steeped in an ochre kettle. It completely absorbs accidental direct taps when placed over exposed hazards, preventing misfires, but provides absolutely zero protection for normal blocks. Frays after 15 blocked strikes.",
    "author": "jules:session",
    "rarity": "rare"
  },
  "affordances": [
    "carry",
    "place_on_tile",
    "sell"
  ],
  "tags": [
    "textile",
    "tile_cover",
    "dampener",
    "solves_tap_misfires",
    "path_field_textile",
    "hazard_guard"
  ],
  "stats": {
    "base_value": 250.0,
    "dampen_pct": 1.0,
    "wear_max": 15.0
  },
  "vars": {
    "wear": 0.0
  },
  "modifiers": [
    {
      "stat": "incoming_damage",
      "phase": "mul",
      "if": "tile.covered_by_self and ctx.is_direct_tap == 1 and tile.is_hazard == 1",
      "value": "1.0 - self.stats.dampen_pct"
    }
  ],
  "reactions": [
    {
      "on": "on_damage_absorbed",
      "if": "tile.covered_by_self",
      "do": [
        {
          "act": "var_add",
          "var": "self.wear",
          "by": "1.0"
        },
        {
          "act": "deal_damage",
          "target": "self_tile",
          "amount": "9999.0",
          "if": "self.wear >= self.stats.wear_max"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/copper": 300
      },
      "unlock_if": "player.max_depth >= 50"
    }
  ],
  "offline": "exact"
}
