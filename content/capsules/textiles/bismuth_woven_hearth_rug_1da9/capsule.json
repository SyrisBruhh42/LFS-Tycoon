{
  "schema": 1,
  "meta": {
    "name": "Bismuth Woven Hearth Rug",
    "description": "A lavish, heavy rug for the house, woven with heat-retaining bismuth. Resting on it grants a persistent sense of deep comfort, increasing yield for deep excavations while rested. However, its thick fibers slowly degrade over 1000 blocks mined.",
    "author": "jules:session",
    "rarity": "common"
  },
  "affordances": [
    "carry",
    "place_in_house",
    "sell"
  ],
  "tags": [
    "textile",
    "solves_house_comfort",
    "path_field_textile"
  ],
  "stats": {
    "base_value": 850.0,
    "wear_max": 1000.0
  },
  "vars": {
    "wear": 0.0,
    "installed": 0.0
  },
  "modifiers": [
    {
      "stat": "yield_mult",
      "phase": "add",
      "if": "self.installed > 0.0 and tile.depth >= 150.0 and player.is_rested > 0.0",
      "value": "0.35"
    }
  ],
  "reactions": [
    {
      "on": "on_enter_house",
      "if": "self.installed == 0.0",
      "do": [
        {
          "act": "var_set",
          "var": "self.installed",
          "value": "1.0"
        }
      ]
    },
    {
      "on": "on_block_break",
      "if": "self.installed > 0.0 and tile.depth >= 150.0 and player.is_rested > 0.0",
      "do": [
        {
          "act": "var_add",
          "var": "self.wear",
          "by": "1.0"
        },
        {
          "act": "destroy_self",
          "if": "self.wear >= self.stats.wear_max"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/crucible_keeper_e935",
      "price": {
        "blocks/copper": 1500
      },
      "unlock_if": "tool.tier >= 4.0"
    }
  ],
  "offline": "none"
}
