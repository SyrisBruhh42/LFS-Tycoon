{
  "schema": 1,
  "meta": {
    "name": "Ochre Dampening Blanket",
    "description": "An apprentice-grade ochre weave. Lay it over a tile to clamp splash damage so the tile survives at 1 HP. Frazzles after 20 hits.",
    "author": "jules:session",
    "rarity": "uncommon"
  },
  "affordances": [
    "carry",
    "place_on_tile",
    "sell"
  ],
  "tags": [
    "textile",
    "tile_cover",
    "dampener",
    "solves_unwanted_splash",
    "path_field_textile",
    "ochre"
  ],
  "stats": {
    "base_value": 15.0,
    "min_hp_clamp": 1.0,
    "wear_max": 20.0
  },
  "vars": {
    "wear": 0.0
  },
  "modifiers": [
    {
      "stat": "min_hp_clamp",
      "phase": "base",
      "if": "tile.covered_by_self and ctx.is_direct_tap == 0",
      "value": "self.stats.min_hp_clamp"
    }
  ],
  "reactions": [
    {
      "on": "on_damage_absorbed",
      "if": "tile.covered_by_self",
      "do": [
        {
          "act": "var_add",
          "var": "self.wear",
          "by": "1.0"
        },
        {
          "act": "destroy_self",
          "if": "self.wear >= self.stats.wear_max"
        }
      ]
    }
  ],
  "offered_by": [
    {
      "vendor": "npcs/peddler_vayne",
      "price": {
        "blocks/dirt": 50
      }
    }
  ]
}
